{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "quick-bar",
  "description": "Minimal capabilities for the Quick Bar overlay window",
  "windows": ["quick-bar"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus"
  ]
}
